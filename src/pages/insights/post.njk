---
layout: base.njk
navyHeader: true
pagination:
  data: insights
  size: 1
  alias: post
permalink: "/insights/{{ post.slug }}/"
eleventyComputed:
  title: "{{ post.title }} — Admizz Group"
  description: "{{ post.deck }}"
---

<section class="bg-navy-deep py-section-sm">
  <div class="shell">
    <a href="/insights/" class="inline-flex items-center gap-2 text-small font-medium text-navy-on-muted hover:text-gold transition-colors duration-press ease-signature fade-up">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M12 7H2M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      All insights
    </a>
    <span class="eyebrow-on-navy mt-8 fade-up" style="animation-delay:60ms">{{ post.venture }}</span>
    <h1 class="mt-4 font-display font-light text-display-2 text-navy-on max-w-[20ch] text-balance fade-up" style="animation-delay:120ms">{{ post.title }}</h1>
    <p class="mt-6 text-body-lg text-navy-on-muted max-w-measure fade-up" style="animation-delay:180ms">{{ post.deck }}</p>
  </div>
</section>

<section class="bg-paper py-section">
  <div class="shell grid grid-cols-1 md:grid-cols-[1fr_16rem] gap-10 md:gap-16">
    <div class="fade-up">
      <div class="rounded-lg overflow-hidden bg-navy-deep mb-10">
        {% imageEager "src/assets/images/insights/" + post.image, post.imageAlt, "(min-width: 768px) 60vw, 100vw" %}
      </div>
      <p class="prose-body text-body-lg leading-relaxed">{{ post.body }}</p>
      <a href="{{ post.ventureHref }}" class="mt-8 inline-flex items-center gap-2 text-small font-medium text-ink link-underline">
        Explore {{ post.venture }}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <aside class="fade-up" style="animation-delay:80ms">
      <span class="eyebrow">More Insights</span>
      <div class="mt-4 flex flex-col">
        {% for other in insights %}
        {% if other.slug != post.slug %}
        <a href="/insights/{{ other.slug }}/" class="py-4 border-t border-rule first:border-t-0 group">
          <span class="font-mono text-micro uppercase tracking-widest text-gold-text">{{ other.venture }}</span>
          <h3 class="mt-1 text-h4 font-display font-book text-ink group-hover:text-gold-text transition-colors duration-press ease-signature">{{ other.title }}</h3>
        </a>
        {% endif %}
        {% endfor %}
      </div>
    </aside>
  </div>
</section>
