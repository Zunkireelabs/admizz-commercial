{# ============================================================ HERO
   Two columns: copy left, photo right — plain, no border/radius/shadow on
   the photo, just the image sitting in its column. #}
<section class="story-hero bg-paper">
  <div class="shell story-hero-grid">
    <div class="story-hero-copy">
      <span class="eyebrow" data-hero-in>Our Story</span>
      <h1 class="mt-4 font-display font-light text-display-2 text-ink text-balance" data-hero-in>
        A journey of <em class="italic text-navy font-book">purpose.</em><br>
        A future of <em class="italic text-gold-text font-book">impact.</em>
      </h1>
      <p class="mt-6 text-body-lg text-ink-muted max-w-measure-tight leading-relaxed" data-hero-in>
        Since 2015, Admizz Group has worked at the intersection of education and opportunity &mdash; helping students and professionals find the preparation, guidance and pathways to their next milestone.
      </p>
      <a href="#journey" class="story-hero-cta" data-hero-in>
        Our journey
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v9M4 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="story-hero-photo" data-hero-in>
      {% imageEager "src/assets/images/story/hero-building-branded.png", "The Admizz mark on a building facade, directional brand imagery", "(min-width: 1000px) 44vw, 92vw" %}
    </div>
  </div>

  {# Proof strip (2026-09-08) — this page previously carried NO evidence at
     all: no number, no credential, nothing a partner could check. Same
     record-strip idiom as /ventures/'s masthead, paper variant.
     Deliberately only hard, independently verifiable facts:
       · 2015 founding year — site.json, from admizz.com itself
       · 3 businesses — the three ventures this site documents
       · 9 destinations — destinations.json, real country list
       · ICEF IAS 6499 — the one independently verified credential in the
         whole project (docs/01-AUDIT.md §2), verifiable at ICEF's own
         directory, and scoped correctly: it is held by Admizz Education,
         which the label states rather than implying it covers the group.
     The admizzeducation-sourced figures (2,000+ students, 95% visa rate,
     etc.) are deliberately NOT here — they're status:draft self-reported
     numbers that need their own provenance caption, and already carry one
     on the homepage. #}
  <div class="shell">
    <dl class="story-proof-strip fade-up" style="animation-delay:160ms">
      <div class="story-proof-item">
        <dt class="font-mono text-label uppercase tracking-widest text-ink-faint">Founded</dt>
        <dd class="story-proof-value mt-2 font-display font-light tabular-nums text-ink">{{ site.founded }}</dd>
        <p class="mt-1.5 text-small text-ink-muted">Denver, Colorado</p>
      </div>
      <div class="story-proof-item">
        <dt class="font-mono text-label uppercase tracking-widest text-ink-faint">Businesses</dt>
        <dd class="story-proof-value mt-2 font-display font-light tabular-nums text-ink">{{ ventures | length }}</dd>
        <p class="mt-1.5 text-small text-ink-muted">Preparation, education, work</p>
      </div>
      <div class="story-proof-item">
        <dt class="font-mono text-label uppercase tracking-widest text-ink-faint">Destinations</dt>
        <dd class="story-proof-value mt-2 font-display font-light tabular-nums text-ink">{{ destinations.countries | length }}</dd>
        <p class="mt-1.5 text-small text-ink-muted">Study countries served</p>
      </div>
      <div class="story-proof-item">
        <dt class="font-mono text-label uppercase tracking-widest text-ink-faint">Accreditation</dt>
        <dd class="story-proof-value mt-2 font-display font-light text-ink">ICEF</dd>
        <p class="mt-1.5 text-small text-ink-muted">
          Agency <span class="tabular-nums">IAS&nbsp;6499</span>, held by Admizz Education
        </p>
      </div>
    </dl>
  </div>
</section>

{# ============================================================ TIMELINE #}
<section id="journey" class="story-journey-section bg-paper-sunk py-section border-t border-rule" data-stack-outgoing>
  <div class="shell">
    <span class="eyebrow fade-up">The Journey</span>
    <h2 class="mt-4 font-display font-light text-h1 text-ink max-w-[16ch] text-balance fade-up" style="animation-delay:80ms">
      Milestones that shaped who we are.
    </h2>

    <div class="story-timeline-track" data-story-timeline>
      <div class="story-timeline-line" aria-hidden="true"></div>
      {% for t in timeline %}
      <div class="story-timeline-row">
        <span class="story-timeline-dot" aria-hidden="true"></span>
        <div class="story-timeline-body">
          <span class="story-timeline-year font-mono text-small font-medium tabular-nums text-navy-soft">{{ t.year }}</span>
          <h3 class="mt-1.5 font-display font-book text-h3 text-ink">{{ t.label }}</h3>
          <p class="mt-1.5 text-body text-ink-muted leading-relaxed max-w-measure-tight">{{ t.text }}</p>
          {# 2026-09-08: timeline.json has carried an `impact` sentence per
             milestone since it was written, and no template ever rendered
             it -- every entry showed only the one-line `text` ("Admizz was
             founded in Denver, Colorado."), which is why this section read
             as thin. This is existing, already-written content being shown,
             not new copy. #}
          {% if t.impact %}
          <p class="mt-3 pt-3 border-t border-rule text-small text-ink-faint leading-relaxed max-w-measure-tight">{{ t.impact }}</p>
          {% endif %}
        </div>
        <div class="story-timeline-photo">
          {% image "src/assets/images/story/" + t.image, t.imageAlt, "(min-width: 700px) 22rem, 90vw" %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ============================================================ THREE BUSINESSES
   Same subjects as /ventures/, a lighter-touch summary here with a direct
   link to each record. "Learn more" points at the real in-page anchor
   /ventures/ already exposes (verified: id="record-{id}" on that page). #}
<section class="story-businesses-section bg-paper py-section" data-stack-incoming>
  <div class="shell">
    <span class="eyebrow fade-up">Our Businesses</span>
    <h2 class="mt-4 font-display font-light text-h1 text-ink max-w-[18ch] text-balance fade-up" style="animation-delay:80ms">
      Three businesses. <em class="italic text-navy font-book">One purpose.</em>
    </h2>
    <p class="mt-4 text-body text-ink-muted max-w-measure-tight leading-relaxed fade-up" style="animation-delay:120ms">
      Different focus areas, a shared conviction that access to opportunity shouldn&rsquo;t depend on where someone starts.
    </p>

    {# 2026-09-06: ascending-tone staggered treatment (reference: Scalient's
       3-step process cards, light-to-accent intensity) — was a flat,
       identical 3-column grid (the same "sameness" pattern already flagged
       and fixed elsewhere on the site, e.g. Beliefs). Card 1 stays the
       plain paper-raised tier; card 2 steps up to a stronger border/shadow;
       card 3 (Work — the group's newest, most active-growth venture) is
       the boldest, inverted to navy. A real index numeral (v.index, already
       in ventures.json) is added per card — nothing new invented, and it's
       the same numbering device used on /ventures/. #}
    <div class="story-venture-grid mt-10">
      {% for v in ventures %}
      <article class="story-venture-card story-venture-card-{{ loop.index }}" data-story-venture-card>
        <span class="story-venture-num" aria-hidden="true">{{ v.index }}</span>
        <span class="story-venture-icon story-venture-icon-{{ v.id }}" aria-hidden="true">
          {% if v.id == "institute" %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><path d="M3 17l1-4 9-9 3 3-9 9-4 1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          {% elif v.id == "education" %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 10h15M10 2.5c4 4.5 4 10.5 0 15-4-4.5-4-10.5 0-15z" stroke="currentColor" stroke-width="1.4"/></svg>
          {% else %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><path d="M3 16V9M8 16V4M13 16v-5M18 16V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          {% endif %}
        </span>
        <h3 class="mt-4 font-display font-book text-h4">{{ v.name }}</h3>
        <p class="story-venture-vertical mt-1 font-mono text-label uppercase tracking-widest">{{ v.vertical }}</p>
        <p class="story-venture-text mt-3 text-small leading-relaxed">{{ v.verticalLine }}</p>
        <a href="/ventures/#record-{{ v.id }}" class="story-venture-link">
          Learn more
          <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 10L10 4M10 4H5.5M10 4v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ============================================================ STATEMENT
   2026-09-08: the page ran paper → grey → paper → grey → CTA with no
   tonal peak anywhere, so the story had no moment that landed. This is
   the same navy statement device the homepage already uses, reusing the
   exact .statement-line hook (main.js staggers those phrase-by-phrase on
   scroll, generic and page-agnostic) rather than inventing a second
   motion idiom. Copy is written framing, not a new factual claim — it
   restates the "three businesses, one group" positioning already
   established on /ventures/ and in the section directly below. #}
<section class="relative overflow-hidden bg-navy-deep py-section-sm">
  {% include "partials/grain-texture.njk" %}
  <div class="shell relative">
    <p class="font-display font-light text-h1 text-navy-on max-w-[38ch] text-balance">
      <span class="statement-line inline-block">Preparation, education and work</span>
      <span class="statement-line inline-block italic text-navy-accent font-book">aren&rsquo;t three industries.</span>
      <span class="statement-line inline-block">They&rsquo;re three stages of the same</span>
      <span class="statement-line inline-block">decision &mdash; so we built for all three.</span>
    </p>
    <span class="statement-line inline-block mt-8 md:block font-mono text-label uppercase tracking-widest text-navy-on-muted">&mdash; Why the group exists</span>
  </div>
</section>

{# ============================================================ LEADERSHIP #}
{# 2026-09-08: was `shell grid [22rem_1fr] items-start` on the full
   min(95vw,2200px) shell — the 1fr text column absorbed the entire
   remaining width while the statement inside stayed at its own measure,
   so the block dead-ended in ~200px of empty grey before the CTA. The
   row now has a reading-width cap of its own and centres its two
   columns against each other, same fix applied to the timeline track
   above. Portrait gets the rounded plate treatment the rest of the site
   uses for photography (.venture-plate, insights cards) instead of a
   bare square of navy. #}
<section class="bg-paper-sunk py-section border-t border-rule">
  <div class="shell">
   <div class="max-w-[64rem] grid grid-cols-1 md:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] gap-10 md:gap-14 items-center">
    <div class="fade-up">
      <div class="overflow-hidden rounded-lg bg-navy-deep aspect-[4/5] [&_picture]:block [&_picture]:h-full [&_img]:block [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:object-top">
        {% image "src/assets/images/people/founder.png", "Manish K Sah, Founder & CEO of Admizz Group", "(min-width: 768px) 19rem, 90vw", [400, 640, 900] %}
      </div>
    </div>
    <div class="fade-up" style="animation-delay:100ms">
      <span class="eyebrow">Leadership</span>
      <h2 class="mt-3 font-display font-light text-h2 text-ink max-w-[16ch] text-balance">A vision for what&rsquo;s next.</h2>
      {# Not a blockquote: no verified personal quote from the founder exists
         in the audit (docs/01-AUDIT.md) for admizz.com itself -- the previous
         version presented invented, paraphrased marketing copy in quotation
         marks as if he'd said it. Replaced with a plain, factual statement
         (site.founder.statement) grounded only in facts already established
         elsewhere on the site. A real quote is an open content request. #}
      <p class="mt-8 font-display italic font-book text-h3 text-ink leading-snug max-w-measure text-balance">
        {{ site.founder.statement }}
      </p>
      <p class="mt-6 text-body font-medium text-ink">{{ site.founder.name }}</p>
      <p class="text-small text-ink-muted">{{ site.founder.title }}, {{ site.founder.org }}</p>
    </div>
   </div>
  </div>
</section>

