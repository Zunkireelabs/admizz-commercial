{# ============================================================ HERO #}
<section class="story-hero bg-paper">
  <div class="shell story-hero-grid">
    <div class="story-hero-copy">
      <span class="eyebrow" data-hero-in>Our Story</span>
      <h1 class="mt-4 font-display font-light text-display-2 text-ink text-balance" data-hero-in>
        A journey of <em class="italic text-navy font-book">purpose.</em><br>
        A future of <em class="italic text-navy font-book">impact.</em>
      </h1>
      <p class="mt-6 text-body-lg text-ink-muted max-w-measure-tight leading-relaxed" data-hero-in>
        Since 2015, Admizz Group has worked at the intersection of education and opportunity &mdash; helping students and professionals find the preparation, guidance and pathways to their next milestone.
      </p>
      <a href="#journey" class="story-hero-cta" data-hero-in>
        Our journey
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v9M4 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="story-hero-photo" data-hero-in>
      {% imageEager "src/assets/images/story/hero-building.jpg", "A modern office building exterior, illustrative only", "(min-width: 1000px) 44vw, 92vw" %}
    </div>
  </div>
</section>

{# ============================================================ TIMELINE #}
<section id="journey" class="bg-paper-sunk py-section border-t border-rule">
  <div class="shell">
    <span class="eyebrow fade-up">The Journey</span>
    <h2 class="mt-4 font-display font-light text-h1 text-ink max-w-[16ch] text-balance fade-up" style="animation-delay:80ms">
      Milestones that shaped who we are.
    </h2>

    <div class="story-timeline-track" data-story-timeline>
      <div class="story-timeline-line" aria-hidden="true"></div>
      {% for t in timeline %}
      <div class="story-timeline-row">
        <span class="story-timeline-dot" aria-hidden="true"></span>
        <div class="story-timeline-body">
          <span class="story-timeline-year font-mono text-small font-medium tabular-nums text-navy-soft">{{ t.year }}</span>
          <h3 class="mt-1.5 font-display font-book text-h3 text-ink">{{ t.label }}</h3>
          <p class="mt-1.5 text-body text-ink-muted leading-relaxed max-w-measure-tight">{{ t.text }}</p>
        </div>
        <div class="story-timeline-photo">
          {% image "src/assets/images/story/" + t.image, t.imageAlt, "(min-width: 700px) 9rem, 40vw" %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ============================================================ THREE BUSINESSES
   Same subjects as /ventures/, a lighter-touch summary here with a direct
   link to each record. "Learn more" points at the real in-page anchor
   /ventures/ already exposes (verified: id="record-{id}" on that page). #}
<section class="bg-paper py-section border-t border-rule">
  <div class="shell">
    <span class="eyebrow fade-up">Our Businesses</span>
    <h2 class="mt-4 font-display font-light text-h1 text-ink max-w-[18ch] text-balance fade-up" style="animation-delay:80ms">
      Three businesses. <em class="italic text-navy font-book">One purpose.</em>
    </h2>
    <p class="mt-4 text-body text-ink-muted max-w-measure-tight leading-relaxed fade-up" style="animation-delay:120ms">
      Different focus areas, a shared conviction that access to opportunity shouldn&rsquo;t depend on where someone starts.
    </p>

    <div class="story-venture-grid mt-10">
      {% for v in ventures %}
      <article class="story-venture-card" data-story-venture-card>
        <span class="story-venture-icon story-venture-icon-{{ v.id }}" aria-hidden="true">
          {% if v.id == "institute" %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><path d="M3 17l1-4 9-9 3 3-9 9-4 1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          {% elif v.id == "education" %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 10h15M10 2.5c4 4.5 4 10.5 0 15-4-4.5-4-10.5 0-15z" stroke="currentColor" stroke-width="1.4"/></svg>
          {% else %}
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><path d="M3 16V9M8 16V4M13 16v-5M18 16V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          {% endif %}
        </span>
        <h3 class="mt-4 font-display font-book text-h4 text-ink">{{ v.name }}</h3>
        <p class="mt-1 font-mono text-micro uppercase tracking-widest text-navy-soft">{{ v.vertical }}</p>
        <p class="mt-3 text-small text-ink-muted leading-relaxed">{{ v.verticalLine }}</p>
        <a href="/ventures/#record-{{ v.id }}" class="story-venture-link">
          Learn more
          <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 10L10 4M10 4H5.5M10 4v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ============================================================ LEADERSHIP #}
<section class="bg-paper-sunk py-section border-t border-rule">
  <div class="shell grid grid-cols-1 md:grid-cols-[minmax(0,22rem)_1fr] gap-10 md:gap-16 items-start">
    <div class="fade-up">
      <div class="rounded-lg overflow-hidden bg-navy-deep">
        {% image "src/assets/images/people/founder.png", "Manish K Sah, Founder & CEO of Admizz Group", "(min-width: 768px) 22rem, 90vw", [400, 640, 900] %}
      </div>
    </div>
    <div class="fade-up" style="animation-delay:100ms">
      <span class="eyebrow">Leadership</span>
      <h2 class="mt-3 font-display font-light text-h2 text-ink max-w-[16ch] text-balance">A vision for what&rsquo;s next.</h2>
      <blockquote class="mt-8 font-display italic font-book text-h3 text-ink leading-snug max-w-measure text-balance">
        &ldquo;{{ site.founder.quote }}&rdquo;
      </blockquote>
      <p class="mt-6 text-body font-medium text-ink">{{ site.founder.name }}</p>
      <p class="text-small text-ink-muted">{{ site.founder.title }}, {{ site.founder.org }}</p>
    </div>
  </div>
</section>

{# ============================================================ CLOSE #}
<section class="relative overflow-hidden bg-navy-deep py-section">
  {% include "partials/facet-field.njk" %}
  <div class="shell relative grid grid-cols-1 md:grid-cols-[1fr_auto] md:items-end gap-8">
    <div class="fade-up">
      <p class="font-display font-light text-display-2 text-navy-on max-w-[20ch] text-balance">
        The story continues. <em class="italic text-navy-accent font-book">We&rsquo;re just getting started.</em>
      </p>
    </div>
    <a href="/ventures/" class="btn-primary shrink-0 fade-up" style="animation-delay:80ms">Explore our ventures</a>
  </div>
</section>
