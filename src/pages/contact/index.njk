              <svg viewBox="0 0 24 24" fill="none"><path d="M6 4h3l1.5 4-2 1.5a11 11 0 005 5l1.5-2 4 1.5v3a2 2 0 01-2.2 2A16 16 0 014 6.2 2 2 0 016 4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </span>
            <div class="contact-info-body">
              <p class="contact-info-title">Phone</p>
              <p class="contact-info-line"><a href="{{ site.phoneHref }}" class="contact-inline-link">+1 (720) 505-3611</a></p>
              <p class="contact-info-line contact-info-dim">Mon&ndash;Fri, 9:00 AM &ndash; 6:00 PM (MST) &nbsp;<span class="contact-confirm-tag">CONFIRM</span></p>
            </div>
