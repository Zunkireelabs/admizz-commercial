              <div class="contact-input-wrap">
                <svg class="contact-input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3h2.5l1.2 3.2-1.6 1.2a9 9 0 004.2 4.2l1.2-1.6L15.7 11v2.5A1.6 1.6 0 0114 15 13 13 0 015 6a1.6 1.6 0 000-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <input id="c-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 (555) 123-4567"
                  class="contact-input contact-input-ic" x-model="fields.phone">
              </div>
            </div>

            <div class="contact-field">
              <label for="c-topic" class="contact-flabel">I&rsquo;m reaching out about <span class="contact-req" aria-hidden="true">*</span></label>
              <div class="contact-input-wrap">
                <svg class="contact-input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 9.5V4.5A1.5 1.5 0 014.5 3h5l7.5 7.5-6.5 6.5L3 9.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7" cy="7" r="1.2" fill="currentColor"/></svg>
                <select id="c-topic" name="topic" class="contact-input contact-input-ic contact-select"
                  x-model="fields.topic" @change="onInput('topic')" @blur="onBlur('topic')"
