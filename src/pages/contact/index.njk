{#
  ============================================================================
  /contact/ — built to match the supplied design mockup (2026-08-27).

  ⚠️  THIS FORM DOES NOT SUBMIT ANYWHERE YET. `submitEnquiry()` in the inline
  component is the single seam for a real POST (CLAUDE.md §7). Until it is
  wired, a valid submit swaps the form for a confirmation panel that says
  plainly the form is not connected and gives the real routes. Revisit that
  copy — and public/robots.txt — before launch (docs/briefs/LAUNCH-BLOCKERS.md).

  ⚠️  FACTS PENDING CLIENT CONFIRMATION (marked CONFIRM below): the "80202"
  ZIP, the "Mon–Fri 9–6 MST" phone hours, the "within 24 hours" reply claim,
  and the "Kathmandu, Nepal — Global Education Hub" second location. None of
  these is verified in this repo. They are placeholders matching the mockup
  and must be confirmed or corrected before this page is public.
  ============================================================================
#}

<div x-data="contactDesk()">

  {# ==================================================== MASTHEAD #}
  <section class="contact-hero">
    <div class="shell contact-hero-inner">
      <div class="contact-hero-copy">
        <span class="contact-kicker">Contact Admizz</span>
        <h1 class="contact-hero-title">
          Let&rsquo;s start a<br><span class="contact-hero-title-accent">conversation.</span>
        </h1>
        <p class="contact-hero-sub">
          Tell us which part of Admizz your message is for and it reaches the team that handles it &mdash; not a general pile.
        </p>

        <ul class="contact-badges">
          <li class="contact-badge">
            <span class="contact-chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v11H8l-4 4V5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </span>
            <span class="contact-badge-text">One inbox &mdash; <strong>routed by topic</strong></span>{# CONFIRM: mockup said "We reply within 24 hours" — no verified SLA #}
          </li>
          <li class="contact-badge">
            <span class="contact-chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 19c.6-3 3-4.5 5.5-4.5S13.9 16 14.5 19M15 15c2 .2 3.8 1.4 4.4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
            <span class="contact-badge-text">Talk to the <strong>right team</strong></span>
          </li>
          <li class="contact-badge">
            <span class="contact-chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="contact-badge-text">Denver, Colorado &mdash; <strong>one home base</strong></span>
          </li>
        </ul>
      </div>

      {# Right-side figure — a paper aircraft on a dotted flight path, matching
         the mockup. Purely decorative: aria-hidden, non-focusable, valid with
         no JS, no motion to disable. #}
      <div class="contact-hero-figure" aria-hidden="true">
        <svg viewBox="0 0 420 320" fill="none" focusable="false">
          <circle cx="320" cy="96" r="132" fill="currentColor" fill-opacity="0.05"/>
          <circle cx="256" cy="188" r="82" fill="currentColor" fill-opacity="0.05"/>
          {# dotted flight path, looping up toward the plane #}
          <path d="M14 262C104 258 150 214 214 206c70-9 96-52 96-92 0-34-30-56-52-40-24 17-16 58 20 66 40 9 78-8 96-42"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="0.5 8"/>
          {# clean 3-facet origami plane #}
          <g transform="translate(300 40) rotate(12)">
            <path d="M96 4 L2 40 L44 52 L60 96 Z" fill="#002856"/>
            <path d="M96 4 L44 52 L2 40 Z" fill="#1B4A7A"/>
            <path d="M96 4 L60 96 L44 52 Z" fill="#001B3B"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  {# ==================================================== BODY #}
  <section class="contact-body">
    <div class="shell contact-body-grid">

      {# -------- Left: the form -------- #}
      <div class="contact-form-col">
        <h2 class="contact-h2">Send us a message</h2>
        <p class="contact-lead">Fill this in and it lands with the team that handles your topic. Nothing goes to a general pile.</p>

        <template x-if="!sent">
          <form class="contact-form contact-form-card" @submit.prevent="handleSubmit" novalidate>

            <div class="contact-field">
              <label for="c-name" class="contact-flabel">Full name <span class="contact-req" aria-hidden="true">*</span></label>
              <div class="contact-input-wrap">
                <svg class="contact-input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="6.5" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M4 16.5c1-3 3.2-4.5 6-4.5s5 1.5 6 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <input id="c-name" name="name" type="text" autocomplete="name" placeholder="Your full name"
                  class="contact-input contact-input-ic" x-model="fields.name" @input="onInput('name')" @blur="onBlur('name')"
                  :aria-invalid="errors.name ? 'true' : 'false'" :aria-describedby="errors.name ? 'c-name-err' : null">
              </div>
              <p id="c-name-err" class="contact-error" role="alert" x-show="errors.name" x-cloak>
                <svg class="contact-error-mark" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5l6.5 11.5H1.5L8 1.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.2M8 11.2v.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                <span x-text="errors.name"></span>
              </p>
            </div>

            <div class="contact-field">
              <label for="c-email" class="contact-flabel">Email address <span class="contact-req" aria-hidden="true">*</span></label>
              <div class="contact-input-wrap">
                <svg class="contact-input-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="4" width="15" height="12" rx="1.6" stroke="currentColor" stroke-width="1.5"/><path d="M3 5.5l7 5 7-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <input id="c-email" name="email" type="email" autocomplete="email" placeholder="you@example.com"
                  class="contact-input contact-input-ic" x-model="fields.email" @input="onInput('email')" @blur="onBlur('email')"
