          <li class="contact-info-item">
            <span class="contact-chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12h17M12 3.5c3 3 3 14 0 17-3-3-3-14 0-17z" stroke="currentColor" stroke-width="1.6"/></svg>
            </span>
            <div class="contact-info-body">
