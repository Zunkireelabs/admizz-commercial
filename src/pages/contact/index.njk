</div>

<script>
  window.contactDesk = function () {
    return {
      submitting: false,
      sent: false,
      fields: { name: '', email: '', phone: '', topic: '', message: '' },
      errors: { name: '', email: '', topic: '', message: '' },
      touched: { name: false, email: false, topic: false, message: false },

      validateField(key) {
        const v = (this.fields[key] || '').trim();
        let msg = '';
        if (key === 'name' && !v) msg = 'Enter your name so we know who to reply to.';
        if (key === 'email') {
          if (!v) msg = 'Enter an email address we can reach you at.';
          else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) msg = 'That doesn’t look like a complete email address.';
        }
        if (key === 'topic' && !v) msg = 'Choose what your message is about.';
        if (key === 'message' && !v) msg = 'Tell us what your enquiry is about.';
        this.errors[key] = msg;
        return !msg;
      },
      onBlur(key) { this.touched[key] = true; this.validateField(key); },
      onInput(key) { if (this.touched[key]) this.validateField(key); },

      handleSubmit() {
        if (this.submitting) return;
        const keys = ['name', 'email', 'topic', 'message'];
        keys.forEach((k) => { this.touched[k] = true; });
        const ok = keys.map((k) => this.validateField(k)).every(Boolean);
        if (!ok) {
          this.$nextTick(() => {
            const first = this.$root.querySelector('[aria-invalid="true"]');
            if (first) first.focus();
          });
          return;
        }
        this.submitting = true;
        this.submitEnquiry({ ...this.fields })
          .then(() => { this.submitting = false; this.sent = true; this.$nextTick(() => { const h = this.$root.querySelector('.contact-confirm h3'); if (h) h.focus(); }); })
          .catch(() => { this.submitting = false; });
      },

      // -----------------------------------------------------------------
      // THE ONE SUBMIT SEAM. Wiring this to the CRM (CLAUDE.md §7 —
      // POST /api/public/submit/admizz/<formSlug>, Bearer form key, CORS)
      // is a change to THIS FUNCTION ONLY. Today it resolves without sending.
      // TODO: POST to CRM
      // -----------------------------------------------------------------
      submitEnquiry(payload) {
        return Promise.resolve(payload);
      },

      topicLabel() {
        return {
          general: 'a general enquiry',
          institute: 'Admizz Institute',
          education: 'Admizz Education',
          workforce: 'Admizz Workforce Solutions',
        }[this.fields.topic] || 'your enquiry';
      },
    };
  };
</script>
