<header class="sticky top-0 z-40 border-b" style="background-color: var(--header-bg); border-color: var(--header-border);">
  <div class="mx-auto flex max-w-content items-center justify-between px-6 py-4">
    <a href="/" class="text-h4 font-display font-semibold" style="color: var(--foreground);">
      {{ site.name }}
    </a>
    <nav class="flex items-center gap-6">
      {% for item in navigation.main %}
      <a href="{{ item.href }}" class="text-small font-medium" style="color: var(--foreground-muted);">
        {{ item.label }}
      </a>
      {% endfor %}
    </nav>
  </div>
</header>
