<header
  {# navyHeader (page front-matter) = the page's first section is a full-bleed navy band,
     so the header can start as a frosted-glass pill with light text over it. Pages that
     open on the paper ground (about, insights index, contact) must NEVER get that light
     state — light text on paper is close to illegible. #}
  x-data="{ open: false, scrolled: false, navyHeader: {{ 'true' if navyHeader else 'false' }} }"
  x-init="scrolled = window.scrollY > 90; window.addEventListener('scroll', () => scrolled = window.scrollY > 90, { passive: true })"
  x-effect="document.body.classList.toggle('overflow-hidden', open)"
  class="fixed inset-x-0 top-0 z-50"
>
  {# header-frame/header-bar: a simple full-width bar by default (the correct
     no-JS/reduced-motion state too — see main.js), morphing into a floating
     pill once scroll starts. header-frame's shrink comes from GSAP tweening
     its margin-left/right, not width — a block element with explicit margins
     and no fixed width auto-shrinks to fill what's left, so the browser does
     the centering, not JS. header-bar's border-radius/box-shadow scrub the
     same way; background/text color is untouched, still the existing
     navyHeader Alpine swap below.
     No px-gutter on <header> itself, deliberately — that used to leave a
     permanent 48px margin on both sides even in the "full-width bar" resting
     state, which isn't full-width at all. GSAP's margin tween now starts
     from a true 0, not from that gutter. #}
  <div class="header-frame">
    <div
      class="header-bar relative flex items-center justify-between gap-4 rounded-none pl-6 pr-3 py-3 overflow-hidden transition-colors duration-slow ease-signature"
      :class="(navyHeader && !scrolled && !open) ? 'bg-white/10 border border-white/25 backdrop-blur-md' : 'bg-white/95 border border-rule backdrop-blur-md'"
    >
      <a href="/" class="header-home flex items-center gap-2 shrink-0" aria-label="{{ site.name }} — home">
        <img
          src="/assets/images/brand/mark-navy.png"
          alt="{{ site.name }}"
          width="140"
          height="42"
          class="h-8 w-auto transition-opacity duration-press"
          :class="(navyHeader && !scrolled && !open) ? 'brightness-0 invert' : ''"
        >
      </a>

      <nav class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2" aria-label="Primary">
        {% for item in navigation.main %}
        <a
          href="{{ item.href }}"
          class="nav-link text-small font-medium transition-colors duration-press ease-signature"
          :class="(navyHeader && !scrolled && !open) ? 'text-navy-on-muted hover:text-white' : 'text-ink-muted hover:text-navy-soft'"
        >{{ item.label }}</a>
        {% endfor %}
      </nav>

      <a
        href="/contact/"
        class="hidden md:inline-flex btn-primary rounded-full"
      >Get in touch</a>

      <button
        type="button"
        @click="open = !open"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full"
        :class="(navyHeader && !scrolled && !open) ? 'text-navy-on' : 'text-ink'"
        :aria-expanded="open"
        aria-controls="mobile-nav"
        aria-label="Toggle menu"
      >
        <svg x-show="!open" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <svg x-show="open" x-cloak width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      {# Scroll-progress line — real position, not decoration; GSAP drives its
         width from actual page-scroll fraction (main.js). Absent entirely (never
         even set) when motion is off, same as every other GSAP-driven element.
         Clipped to the pill's rounded shape by the parent's overflow-hidden. #}
      <div class="scroll-progress absolute inset-x-0 bottom-0 h-px bg-navy origin-left scale-x-0" aria-hidden="true"></div>
    </div>
  </div>

  <nav
    id="mobile-nav"
    x-show="open"
    x-cloak
    x-collapse
    class="md:hidden mx-gutter mt-3 rounded-3xl bg-paper border border-rule shadow-lg shadow-navy-deep/10 max-h-[calc(100dvh-6rem)] overflow-y-auto"
    aria-label="Mobile"
  >
    <div class="px-6 py-6 flex flex-col gap-1">
      {% for item in navigation.main %}
      <a
        href="{{ item.href }}"
        @click="open = false"
        class="py-3 text-h4 font-display font-book text-ink border-b border-rule last:border-b-0"
      >{{ item.label }}</a>
      {% endfor %}
      <a href="/contact/" @click="open = false" class="btn-primary rounded-full mt-5 justify-center">Get in touch</a>
    </div>
  </nav>
</header>
