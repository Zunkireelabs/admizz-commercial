<!DOCTYPE html>
<html lang="en">
<head>
  {# Scroll-restoration fix (2026-09-02): browsers auto-restore the previous
     scroll position on refresh/back-forward, which meant the fixed header's
     scroll -> floating-pill morph (main.js) could render fully "scrolled"
     (rounded, narrower, no animation) the instant a page loaded, with no
     actual scrolling by the visitor to trigger it -- confirmed by a direct
     repro (scroll to 400px, reload, header was already 999px-radius 50ms
     later). This has to run inline, first, synchronous -- before the
     browser has a chance to restore scroll and before anything else in
     <head> can delay it. Skipped when the URL has a hash (a #section
     deep link) so that still scrolls to its target normally. #}
  <script>
    if (history.scrollRestoration) history.scrollRestoration = 'manual';
    if (!location.hash) window.scrollTo(0, 0);
  </script>

  <!-- Google Analytics -->
  {% if env.GA_MEASUREMENT_ID %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ env.GA_MEASUREMENT_ID }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ env.GA_MEASUREMENT_ID }}');
  </script>
  {% endif %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.meta.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Robots: noindex for non-production environments -->
  {% if env.ELEVENTY_ENV != 'production' %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}

  <!-- Fonts: self-hosted (2026-09-06 -- closes the CLAUDE.md §5/§6 build-debt
       item; @font-face declarations live in main.css). Newsreader only,
       matching the live single-font experiment (tailwind.config.js) -- see
       the comment above the @font-face rules for why Archivo/Chivo Mono
       aren't fetched at all right now. One preload for the roman/latin
       face: it's the one every visitor needs immediately (hero heading +
       all body text), the italic/latin-ext faces can resolve lazily. -->
  <link rel="preload" href="/assets/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.meta.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.meta.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og-image.png">

  <!-- Canonical URL -->
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ site.url }}{{ canonicalUrl }}">
  {% else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}

  <!-- Schema.org - Organization (Global) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "@id": "{{ site.url }}/#organization",
    "name": "{{ site.legalName }}",
    "alternateName": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "foundingDate": "{{ site.founded }}",
    "logo": "{{ site.url }}/assets/images/brand/mark-navy.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Denver",
      "addressRegion": "CO",
      "addressCountry": "US"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "{{ site.email }}",
      "telephone": "{{ site.phone }}",
      "url": "{{ site.url }}/contact/"
    }
  }
  </script>

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.legalName }}",
    "url": "{{ site.url }}/",
    "description": "{{ site.description }}"
  }
  </script>
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
</head>
<body class="font-sans antialiased bg-paper text-ink">

  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <!-- Main JS + CSS (bundled via Vite) -->
  <script type="module" src="/assets/js/main.js"></script>

</body>
</html>
