<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Analytics -->
  {% if env.GA_MEASUREMENT_ID %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ env.GA_MEASUREMENT_ID }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ env.GA_MEASUREMENT_ID }}');
  </script>
  {% endif %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.meta.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Robots: noindex for non-production environments -->
  {% if env.ELEVENTY_ENV != 'production' %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}

  <!-- Fonts: self-hosting + axis instancing is tracked as build debt (CLAUDE.md §5/§6).
       CDN is used for the demo; latin-ext keeps ₹ and transliterated names correct. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Chivo+Mono:wght@300..700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap&subset=latin,latin-ext">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.meta.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.meta.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og-image.png">

  <!-- Canonical URL -->
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ site.url }}{{ canonicalUrl }}">
  {% else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}

  <!-- Schema.org - Organization (Global) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "@id": "{{ site.url }}/#organization",
    "name": "{{ site.legalName }}",
    "alternateName": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "foundingDate": "{{ site.founded }}",
    "logo": "{{ site.url }}/assets/images/brand/mark-navy.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Denver",
      "addressRegion": "CO",
      "addressCountry": "US"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "{{ site.email }}",
      "telephone": "{{ site.phone }}",
      "url": "{{ site.url }}/contact/"
    }
  }
  </script>

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.legalName }}",
    "url": "{{ site.url }}/",
    "description": "{{ site.description }}"
  }
  </script>
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
</head>
<body class="font-sans antialiased bg-paper text-ink">

  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <!-- Main JS + CSS (bundled via Vite) -->
  <script type="module" src="/assets/js/main.js"></script>

</body>
</html>
